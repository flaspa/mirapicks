# Copy to .env and fill in. Never commit .env.

# Vultr infrastructure management only (VMs, firewall). Never used for inference.
VULTR_API_KEY=

# Vultr Serverless Inference only. Never used for infrastructure management.
VULTR_INFERENCE_API_KEY=

# Vultr Serverless Inference model IDs
NIGEL_MODEL=deepseek-v4-flash-0731
MIRA_MODEL=glm-5.3

# Scout sandbox (defaults shown)
SCOUT_IMAGE=mira-scout:0.1
SCOUT_NETWORK=bridge
SCOUT_TIMEOUT_S=120

# Bright Data TikTok trend discovery for Emily (trusted backend only; never enters sandboxes)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_TIKTOK_DATASET_ID=gd_m7n5ixlw1gc4no56kx
EMILY_TREND_POSTS=10

# Andy (fashion press scout) model on Vultr Serverless Inference
ANDY_MODEL=nemotron-3-nano-omni-30b-a3b-reasoning
